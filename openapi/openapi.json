{"openapi":"3.1.0","info":{"title":"NLP Analysis API","description":"REST API for NLP operations including sentiment analysis and zero-shot text classification using DJL. Both capabilities are powered by a unified DistilBERT model.","version":"0.1-SNAPSHOT"},"servers":[{"url":"https://localhost:8080","description":"NLP analysis service running locally."}],"tags":[{"name":"sentiment-analysis","description":"API operations used for obtaining a sentiment analysis."},{"name":"text-classification","description":"API operations for zero-shot text classification."}],"paths":{"/api/classify":{"post":{"tags":["text-classification"],"summary":"Classify text into categories","description":"Performs zero-shot text classification using a unified MNLI model. Returns ranked categories with confidence scores.","operationId":"classify","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ClassificationRequest"}}},"required":true},"responses":{"500":{"description":"Internal Server Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorDescription"}}}},"200":{"description":"OK","content":{"application/json":{"schema":{"$ref":"#/components/schemas/TextClassification"}}}},"400":{"description":"Bad Request","content":{"application/json":{"schema":{"$ref":"#/components/schemas/TextClassification"}}}},"401":{"description":"Unauthorized","content":{"application/json":{"schema":{"$ref":"#/components/schemas/TextClassification"}}}},"403":{"description":"Forbidden","content":{"application/json":{"schema":{"$ref":"#/components/schemas/TextClassification"}}}},"404":{"description":"Not Found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/TextClassification"}}}}}}},"/api/analyze":{"post":{"tags":["Sentence"],"summary":"Get a sentiment analysis on a sentence of text.","description":"The API returns a sentiment analysis based on a predefined ML model.","operationId":"analyze","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Sentence"}}},"required":true},"responses":{"500":{"description":"Internal Server Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorDescription"}}}},"200":{"description":"OK","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SentimentAnalysis"}}}},"400":{"description":"Bad Request","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SentimentAnalysis"}}}},"401":{"description":"Unauthorized","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SentimentAnalysis"}}}},"403":{"description":"Forbidden","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SentimentAnalysis"}}}},"404":{"description":"Not Found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SentimentAnalysis"}}}}}}}},"components":{"schemas":{"ClassificationRequest":{"type":"object","description":"A text classification request","properties":{"text":{"type":"string","description":"The text to classify","example":"I love eating pizza"},"categories":{"type":"array","description":"List of candidate categories","example":["food","technology","sports"],"items":{"type":"string"}}}},"CategoryScore":{"type":"object","description":"A category with its confidence score","properties":{"category":{"type":"string","description":"The category label"},"confidence":{"type":"string","description":"Confidence score as percentage (format: ##0.00000%)"}}},"TextClassification":{"type":"object","description":"The result of a text classification","properties":{"text":{"type":"string","description":"The original text that was classified"},"classifications":{"type":"array","description":"Ranked categories with confidence scores","items":{"$ref":"#/components/schemas/CategoryScore"}}}},"ErrorDescription":{"type":"object","properties":{"error":{"type":"string","description":"The error description, usually 'error'"},"status":{"type":"integer","format":"int32","description":"The HTTP Status code for this error."}}},"Sentence":{"type":"object","description":"The sentence to analyze","properties":{"sentence":{"type":"string"}}},"SentimentAnalysis":{"type":"object","description":"The result of a sentiment analysis","properties":{"sentence":{"type":"string","description":"The sentence to analyze"},"positive_probability":{"type":"string","description":"The probability that the sentence is positive in the format ##0.00000%"},"negative_probability":{"type":"string","description":"The probability that the sentence is negative in the format ##0.00000%"}}}}}}